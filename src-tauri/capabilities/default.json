{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:path:default",
    "dialog:default",
    "dialog:allow-save",
    "opener:default",
    "opener:allow-open-url",
    "os:default"
  ]
}
