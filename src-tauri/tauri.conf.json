{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super IP Scanner",
  "version": "0.1.0",
  "identifier": "com.bradheffernan.superipscanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Super IP Scanner",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "© 2026 Brad Heffernan",
    "shortDescription": "Fast cross-platform IP scanner",
    "longDescription": "Super IP Scanner combines the speed and reliability of multiple scanning techniques (ARP, ICMP, TCP) with rich hostname resolution (DNS, NetBIOS, mDNS) to produce accurate, fast network scans on Windows and Linux.",
    "homepage": "https://github.com/bradheffernan/super-ip-scanner",
    "publisher": "Brad Heffernan",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"],
        "section": "net",
        "postInstallScript": "scripts/postinstall.sh",
        "desktopTemplate": "scripts/super-ip-scanner.desktop"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3"],
        "epoch": 0,
        "release": "1",
        "postInstallScript": "scripts/postinstall.sh",
        "desktopTemplate": "scripts/super-ip-scanner.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {}
}
